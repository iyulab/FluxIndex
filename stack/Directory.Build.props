<Project>
  <!-- Import parent build settings -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Stack-specific suppressions -->
    <!-- CS0219: unused local, CS0618: obsolete, CS1570: XML doc -->
    <NoWarn>$(NoWarn);CS0219;CS0618;CS1570</NoWarn>
    <!-- CA1000: generic factory methods (ApiResponse<T>.Ok/Fail, PagedResult<T>.Create) — standard C# pattern -->
    <!-- CA1711: Collection entity — domain name, not a .NET collection type -->
    <!-- CA1716: FluxIndex.Stack.Shared namespace — standard .NET project naming, VB.NET keyword irrelevant -->
    <!-- MCP002: MCP server protocol -->
    <NoWarn>$(NoWarn);CA1000;CA1711;CA1716;MCP002</NoWarn>
  </PropertyGroup>
</Project>
