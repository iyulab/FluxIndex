<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>fluxindex</AssemblyName>
    <RootNamespace>FluxIndex.CLI</RootNamespace>

    <!-- CLI tool settings -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fluxindex</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>

    <!-- Package metadata for local tool installation -->
    <IsPackable>true</IsPackable>
    <PackageId>FluxIndex.CLI</PackageId>
    <Version>0.3.1</Version>
    <Description>FluxIndex CLI - Document processing and RAG indexing tool</Description>
    <Authors>FluxIndex</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- FluxIndex SDK and Extensions -->
    <ProjectReference Include="..\..\src\FluxIndex.SDK\FluxIndex.SDK.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.Extensions.FileFlux\FluxIndex.Extensions.FileFlux.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.AI.OpenAI\FluxIndex.AI.OpenAI.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.AI.Local\FluxIndex.AI.Local.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CLI Framework -->
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />

    <!-- Configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>
