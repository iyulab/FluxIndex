<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>fluxindex</AssemblyName>
    <RootNamespace>FluxIndex.CLI</RootNamespace>

    <!-- CLI tool settings -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fluxindex</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>

    <!-- NU5111: Playwright runtime scripts in tools/ are expected, not NuGet install hooks -->
    <NoWarn>$(NoWarn);NU5111</NoWarn>

    <!-- Package metadata for local tool installation -->
    <IsPackable>true</IsPackable>
    <PackageId>FluxIndex.CLI</PackageId>
    <Version>0.4.0</Version>
    <Description>FluxIndex CLI - Document processing and RAG indexing tool</Description>
    <Authors>FluxIndex</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- FluxIndex SDK (FileFlux, WebFlux, FluxCurator, FluxImprover) -->
    <ProjectReference Include="..\..\src\FluxIndex.SDK\FluxIndex.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- LMSupply for local AI (direct reference) -->
    <PackageReference Include="LMSupply.Embedder" />
    <PackageReference Include="LMSupply.Generator" />
  </ItemGroup>

  <ItemGroup>
    <!-- CLI Framework -->
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />

    <!-- Configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>
