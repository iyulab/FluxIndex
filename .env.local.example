# FluxIndex Configuration
# Copy this file to .env.local and fill in your actual values
# The .env.local file is already in .gitignore and will not be committed

# ============================================================
# OpenAI Configuration (for production and real API tests)
# ============================================================

# Required: Your OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Model configuration
OPENAI_MODEL_NAME=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_COMPLETION_MODEL=gpt-5-nano

# ============================================================
# Test Configuration
# ============================================================
#
# Test Behavior:
# - WITH .env.local file: Tests use REAL OpenAI API (costs money!)
# - WITHOUT .env.local file: Tests use mocked responses (free, fast)
#
# To use real API for tests:
# 1. Copy this file: cp .env.local.example .env.local
# 2. Edit .env.local and add your OpenAI API key
# 3. Run tests: dotnet test (or pwsh scripts/full-test.ps1)
#
# Note: .env.local is gitignored for security
# CI/CD will always use mocked responses (no .env.local file)
#
# ============================================================

# Alternative: Use User Secrets for more secure configuration
# Run: dotnet user-secrets set "OpenAI:ApiKey" "your_api_key"
# Run: dotnet user-secrets set "OpenAI:ModelName" "gpt-5-nano"