<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>FluxIndex.AI.LocalEmbedder</PackageId>
    <IsPackable>true</IsPackable>
    <Description>FluxIndex LocalEmbedder integration - Local ONNX-based text embedding service</Description>
    <PackageTags>RAG;VectorStore;Embeddings;LocalEmbedder;ONNX;Local</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxIndex.Core\FluxIndex.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LocalEmbedder" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
