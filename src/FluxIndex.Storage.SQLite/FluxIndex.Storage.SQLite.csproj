<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>FluxIndex.Storage.SQLite</PackageId>
    <IsPackable>true</IsPackable>
    <Description>SQLite storage provider for FluxIndex</Description>
    <!-- sqlite-vec is still in alpha -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <PackageTags>FluxIndex;SQLite;Storage;Embedded;Database</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FluxIndex.Storage.SQLite.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="sqlite-vec" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <!-- Flows to every project that references the package, directly or through another package. -->
  <ItemGroup>
    <None Include="buildTransitive\FluxIndex.Storage.SQLite.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\FluxIndex.Storage.SQLite.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxIndex.Core\FluxIndex.Core.csproj" />
    <ProjectReference Include="..\FluxIndex.SDK\FluxIndex.SDK.csproj" />
  </ItemGroup>

</Project>
