<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>FluxIndex.Cache.Redis</AssemblyName>
    <RootNamespace>FluxIndex.Cache.Redis</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>FluxIndex.Cache.Redis</PackageId>
    <Description>Redis for FluxIndex: a semantic query cache (hits by query-embedding similarity) and an ICacheStore for embedding, query-result and entity caching.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxIndex.Core\FluxIndex.Core.csproj" />
    <ProjectReference Include="..\FluxIndex.SDK\FluxIndex.SDK.csproj" />
  </ItemGroup>

</Project>