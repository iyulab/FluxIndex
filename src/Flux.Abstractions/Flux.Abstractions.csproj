<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>Flux.Abstractions</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Shared abstractions for the Flux ecosystem - IEnrichedChunk, ISourceMetadata, and related interfaces for RAG data pipeline interoperability</Description>
    <PackageTags>RAG;Flux;Abstractions;Interfaces;Chunks;Metadata</PackageTags>
  </PropertyGroup>

  <!-- No dependencies - pure interfaces only -->

</Project>
