<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>FluxIndex.Extensions.FluxImprover</PackageId>
    <IsPackable>true</IsPackable>
    <Description>FluxImprover integration extensions for FluxIndex - LLM-powered chunk enrichment and quality evaluation</Description>
    <PackageTags>FluxIndex;FluxImprover;RAG;Quality;Enrichment;Evaluation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluxImprover" />
    <!-- DI and Logging abstractions come transitively from FluxImprover -->
  </ItemGroup>

  <!-- Project references to FluxIndex Core and SDK -->
  <ItemGroup>
    <ProjectReference Include="..\FluxIndex.Core\FluxIndex.Core.csproj" />
    <ProjectReference Include="..\FluxIndex.SDK\FluxIndex.SDK.csproj" />
  </ItemGroup>

</Project>
