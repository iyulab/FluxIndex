<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>CLI tool for FluxIndex RAG MCP service - memorize, search, and serve knowledge bases</Description>
    <AssemblyName>FluxIndex.CLI</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fluxindex</ToolCommandName>
    <PackageId>FluxIndex.CLI</PackageId>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxIndex.MCP\FluxIndex.MCP.csproj" />
  </ItemGroup>

</Project>
