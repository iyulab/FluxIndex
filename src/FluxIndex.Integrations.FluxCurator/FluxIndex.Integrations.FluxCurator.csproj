    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>FluxIndex.Integrations.FluxCurator</PackageId>
    <IsPackable>true</IsPackable>
    <Description>FluxCurator text preprocessing integration for FluxIndex — DI wiring and embedding adapters.</Description>
    <PackageTags>RAG;VectorStore;FluxIndex;FluxCurator;Integration</PackageTags>
