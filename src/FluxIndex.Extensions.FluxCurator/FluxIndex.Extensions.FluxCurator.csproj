<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>FluxIndex.Extensions.FluxCurator</PackageId>
    <IsPackable>true</IsPackable>
    <Description>FluxCurator integration extensions for FluxIndex - PII masking, content filtering, and semantic chunking</Description>
    <PackageTags>FluxIndex;FluxCurator;RAG;PII;Masking;Chunking;Preprocessing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluxCurator" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxIndex.Core\FluxIndex.Core.csproj" />
  </ItemGroup>

</Project>
