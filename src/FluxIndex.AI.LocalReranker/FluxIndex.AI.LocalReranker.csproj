<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>FluxIndex.AI.LocalReranker</PackageId>
    <Title>FluxIndex LocalReranker Integration</Title>
    <Description>Optional LocalReranker adapter for FluxIndex RAG infrastructure. Provides cross-encoder based semantic reranking using local ONNX models. Zero-configuration, no API keys required.</Description>
    <PackageTags>FluxIndex;RAG;Reranker;CrossEncoder;ONNX;SemanticSearch;LocalInference</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxIndex.Core\FluxIndex.Core.csproj" />
    <ProjectReference Include="..\FluxIndex.SDK\FluxIndex.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LocalReranker" />
  </ItemGroup>

  <!-- Allow tests to access internal types -->
  <ItemGroup>
    <InternalsVisibleTo Include="FluxIndex.AI.LocalReranker.Tests" />
  </ItemGroup>

</Project>
