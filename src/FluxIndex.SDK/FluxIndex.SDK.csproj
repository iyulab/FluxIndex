<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>FluxIndex.SDK</PackageId>
    <IsPackable>true</IsPackable>
    <Description>FluxIndex SDK - Complete RAG infrastructure with LocalAI embeddings, FileFlux integration, FluxCurator preprocessing, and FluxImprover quality enhancement</Description>
    <PackageTags>RAG;VectorStore;Search;AI;Embeddings;Retrieval;SDK;LocalAI;FileFlux;FluxCurator;FluxImprover</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxIndex.Core\FluxIndex.Core.csproj" />
    <ProjectReference Include="..\FluxIndex.Storage.SQLite\FluxIndex.Storage.SQLite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core dependencies -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />

    <!-- LocalAI dependencies (from AI.Local) -->
    <PackageReference Include="LocalAI.Embedder" />
    <PackageReference Include="LocalAI.Reranker" />

    <!-- Document processing dependencies (from Extensions) -->
    <PackageReference Include="FileFlux" />
    <PackageReference Include="FluxCurator" />
    <PackageReference Include="FluxImprover" />
    <PackageReference Include="WebFlux" />
  </ItemGroup>

</Project>
