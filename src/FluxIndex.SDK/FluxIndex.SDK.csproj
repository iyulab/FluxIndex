<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>FluxIndex.SDK</PackageId>
    <IsPackable>true</IsPackable>
    <Description>FluxIndex SDK - RAG orchestration core (context, indexer, retriever, DI helpers). Storage and pipeline integrations ship as separate FluxIndex.Storage.* / FluxIndex.Integrations.* packages.</Description>
    <PackageTags>RAG;VectorStore;Search;AI;Embeddings;Retrieval;SDK</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxIndex.Core\FluxIndex.Core.csproj" />
    <!-- Storage providers are now optional. Consumers reference FluxIndex.Storage.* packages directly.
         Each storage package provides extension methods on FluxIndexContextBuilder. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Core dependencies -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>


  <ItemGroup>
    <!-- The options mapper and other internals are covered by the SDK test project. -->
    <InternalsVisibleTo Include="FluxIndex.SDK.Tests" />
  </ItemGroup>

</Project>
