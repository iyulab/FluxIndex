<Project>
  <!-- Central Package Management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Microsoft.Extensions Packages - .NET 10.0 -->
  <!-- Only packages directly referenced in *.csproj files -->
  <ItemGroup>
    <!-- FluxGuard (opt-in RAG security pipeline — see FluxIndex.SDK.Retriever) -->
    <PackageVersion Include="FluxGuard.Remote" Version="0.13.0" />
    <!-- Caching -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.8" />
    <!-- Configuration -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.8" />
    <!-- DI -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <!-- Hosting -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <!-- Http -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <!-- Logging -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Testing" Version="10.0.2" />
    <!-- Options -->
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.8" />
    <!-- Misc -->
    <PackageVersion Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>
  <!-- Entity Framework Core Packages - .NET 10.0 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageVersion Include="Pgvector" Version="0.3.0" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.0" />
  </ItemGroup>
  <!-- AI/ML Packages -->
  <ItemGroup>
    <PackageVersion Include="Anthropic.SDK" Version="5.8.0" />
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="Google.Cloud.AIPlatform.V1" Version="3.76.0" />
    <PackageVersion Include="Mscc.GenerativeAI" Version="2.5.2" />
    <!-- LMSupply: Full AI stack (Embedder + Generator + Reranker) -->
    <PackageVersion Include="LMSupply.Embedder" Version="0.42.2" />
    <PackageVersion Include="LMSupply.Generator" Version="0.42.2" />
    <PackageVersion Include="LMSupply.Reranker" Version="0.42.2" />
  </ItemGroup>
  <!-- Storage/Cache Packages -->
  <ItemGroup>
    <PackageVersion Include="StackExchange.Redis" Version="3.1.31" />
    <PackageVersion Include="sqlite-vec" Version="0.1.7-alpha.2.1" />
    <!-- cycle-171: explicit lift — Microsoft.Data.Sqlite 10.0.8 pulls SQLitePCLRaw 2.1.11
         (NU1903 high, GHSA-2m69-gcr7-jv3q); upstream 2.1.12 stable landed 2026-07-09. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Graph Database -->
    <PackageVersion Include="Neo4j.Driver" Version="6.1.1" />
    <!-- Vector Database -->
    <PackageVersion Include="Qdrant.Client" Version="1.18.1" />
    <PackageVersion Include="Testcontainers.Qdrant" Version="4.14.0" />
  </ItemGroup>
  <!-- Shared ecosystem contract. Produced by its own repository so it can sit below every
       package that consumes it; consuming it here as a package rather than a project is what
       keeps the dependency graph acyclic. -->
  <ItemGroup>
    <PackageVersion Include="Flux.Abstractions" Version="0.24.0" />
  </ItemGroup>
  <!-- Document Processing & Quality -->
  <ItemGroup>
    <PackageVersion Include="FileFlux" Version="0.20.1" />
    <PackageVersion Include="FluxCurator" Version="0.8.1" />
    <PackageVersion Include="FluxImprover" Version="0.11.1" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageVersion Include="WebFlux" Version="0.7.0" />
  </ItemGroup>
  <!-- Testing Packages -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- 4.14.0 (2026-08-17): SSH.NET transitive floor lift. Testcontainers 4.13.0 and below
         pull SSH.NET 2025.1.0 (GHSA-q939-rpr3-3284, High: ScpClient recursive download allows
         arbitrary file write via server-controlled SCP filenames); 4.14.0 is the first release
         that moved its SSH.NET dependency to 2026.0.0. Test-only (Testcontainers.*.Tests
         projects), but this repo does not suppress a live High regardless of layer. -->
    <PackageVersion Include="Testcontainers" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Neo4j" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.14.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>
  <!-- MCP/CLI Packages -->
  <ItemGroup>
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.8" />
  </ItemGroup>
  <!-- OpenTelemetry Observability Packages -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.18.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.14.0-beta.1" />
  </ItemGroup>
  <!-- Web/API Packages -->
  <ItemGroup>
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.0" />
  </ItemGroup>
  <!-- Build/Development Packages -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="DotNetEnv" Version="3.1.1" />
    <PackageVersion Include="Spectre.Console" Version="0.55.2" />
  </ItemGroup>
</Project>