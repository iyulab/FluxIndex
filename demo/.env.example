# FluxIndex Demo Environment Configuration
# Copy this file to .env and customize as needed

# ===========================================
# Storage Backend Selection
# ===========================================
# Options: sqlite, postgresql
STORAGE_BACKEND=postgresql

# ===========================================
# PostgreSQL Configuration (pgvector)
# ===========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fluxindex
POSTGRES_PASSWORD=fluxindex123
POSTGRES_DB=fluxindex

# Full connection string (auto-generated if not set)
# POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=fluxindex;Username=fluxindex;Password=fluxindex123

# ===========================================
# Neo4j Configuration (Graph Database)
# ===========================================
NEO4J_HOST=localhost
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fluxindex123

# ===========================================
# Redis Configuration (Optional Cache)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ===========================================
# AI/Embedding Configuration
# ===========================================
# OpenAI API Key (leave empty to use local embeddings)
OPENAI_API_KEY=

# Embedding model selection
# Options: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local embedding model (used when OPENAI_API_KEY is empty)
# Options: all-MiniLM-L6-v2, all-mpnet-base-v2
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Embedding dimensions (auto-detected from model if not set)
# EMBEDDING_DIMENSIONS=1536

# ===========================================
# Application Settings
# ===========================================
# Server port
APP_PORT=5000

# Enable detailed logging
ENABLE_DETAILED_LOGGING=true

# Enable graph traversal features
ENABLE_GRAPH_FEATURES=true
