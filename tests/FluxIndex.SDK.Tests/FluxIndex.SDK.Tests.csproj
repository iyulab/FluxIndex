<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Iyu.Conventions.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Testcontainers for integration tests -->
    <PackageReference Include="Testcontainers.Neo4j" />
    <PackageReference Include="Testcontainers.Qdrant" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FluxIndex.SDK\FluxIndex.SDK.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.Integrations.FileFlux\FluxIndex.Integrations.FileFlux.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.Integrations.WebFlux\FluxIndex.Integrations.WebFlux.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.Core\FluxIndex.Core.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.Storage.SQLite\FluxIndex.Storage.SQLite.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.Storage.Neo4j\FluxIndex.Storage.Neo4j.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.Storage.Qdrant\FluxIndex.Storage.Qdrant.csproj" />
    <!-- The remaining library assemblies, referenced so OptionsReachabilityRosterTests scans every
         public *Options type the packages ship — an option read only in an assembly that is not loaded
         would otherwise be reported as unread. -->
    <ProjectReference Include="..\..\src\FluxIndex.Storage.PostgreSQL\FluxIndex.Storage.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.Cache.Redis\FluxIndex.Cache.Redis.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.Integrations.FluxCurator\FluxIndex.Integrations.FluxCurator.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.Integrations.FluxImprover\FluxIndex.Integrations.FluxImprover.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.Integrations.FluxGuard\FluxIndex.Integrations.FluxGuard.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.Providers.LMSupply\FluxIndex.Providers.LMSupply.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.Providers.OpenAI\FluxIndex.Providers.OpenAI.csproj" />
    <ProjectReference Include="..\..\src\FluxIndex.MCP\FluxIndex.MCP.csproj" />
    <!-- Shared IVectorStore filter-contract suite (VectorStoreFilterContractSuite) -->
    <ProjectReference Include="..\FluxIndex.Core.Tests\FluxIndex.Core.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- LMSupply for local AI (direct reference) -->
    <PackageReference Include="LMSupply.Embedder" />
  </ItemGroup>

  <ItemGroup>
    <!-- What docs/AI_PROVIDER_INTEGRATION.md's samples compile against (ProviderGuideSnippetCompileTests): the OpenAI SDK
         for the own-implementation samples and ASP.NET Core for the web host sample. -->
    <PackageReference Include="OpenAI" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\SqliteTestPools.cs" Link="Shared\SqliteTestPools.cs" />
  </ItemGroup>

</Project>
