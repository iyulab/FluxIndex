<Project>
  <!-- MSBuild imports only the NEAREST Directory.Build.props by default; without this explicit
       chain-import, everything the root Directory.Build.props sets (RestoreAdditionalProjectSources
       for local-packages, Version, analyzer settings, etc.) is silently shadowed for every project
       under tests/. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- Tests-specific build configuration -->
  <PropertyGroup>
    <!-- Tests are never packable -->
    <IsPackable>false</IsPackable>

    <!-- Disable documentation generation for tests -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Test-specific build settings -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>

    <!-- Disable unnecessary warnings for tests -->
    <NoWarn>$(NoWarn);CS1591;CS1587;CS8618</NoWarn>

  </PropertyGroup>

  <!-- xUnit v3 test projects are stand-alone executables.
       FluxIndex.LocalSimulation is a console app under tests/ (its own Program.cs entry
       point), not an xUnit project — OutputType=Exe plus the xUnit-generated entry point
       would give it two Main methods, and that conflict silently removes test discovery,
       so it's excluded from this and the package ItemGroup below. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'FluxIndex.LocalSimulation'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Common test dependencies. xUnit v3 pilot rollout: xunit replaced with xunit.v3, no
       Microsoft.NET.Test.Sdk (not required under Microsoft.Testing.Platform),
       coverlet.collector replaced with its MTP-native successor coverlet.MTP
       (build-and-release.yml's scripts/test.ps1 -Coverage is real usage, not a dead
       reference). xunit.runner.visualstudio kept for IDE Test Explorer discovery. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'FluxIndex.LocalSimulation'">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- MTP equivalent of VSTest's blame-hang: a hung test produces a dump instead of a silent job timeout -->
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

</Project>